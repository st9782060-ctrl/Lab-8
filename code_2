#include <iostream>

using namespace std;

int main() {
    const int n = 10;
    int arr[n] = {-4, 7, -12, 3, -1, 25, -8, 25, -3, 10};

    cout << "Original array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    // Знаходимо індекс першого максимального елемента
    int maxIndex = 0;
    for (int i = 1; i < n; i++) {
        if (arr[i] > arr[maxIndex]) {
            maxIndex = i;
        }
    }

    cout << "First maximum element: " << arr[maxIndex] << " (at index " << maxIndex << ")" << endl;

    // Замінюємо нулями всі від'ємні елементи до maxIndex
    for (int i = 0; i < maxIndex; i++) {
        if (arr[i] < 0) {
            arr[i] = 0;
        }
    }

    cout << "Modified array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
